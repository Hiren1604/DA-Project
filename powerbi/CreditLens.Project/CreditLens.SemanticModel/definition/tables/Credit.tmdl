table Credit
	lineageTag: cc718e87-6a3d-4ee8-9331-7d3c2db9ca7b

	measure 'Total Industry Credit Cr' = CALCULATE(MAX(Credit[credit_outstanding_cr]), Credit[hierarchy_level] = "grand_total")
		formatString: #,0.00
		lineageTag: 5c156fbc-e806-481e-8025-896b7b9638f0

	measure 'YoY Credit Growth' = CALCULATE(MAX(Credit[yoy_growth_pct]), Credit[hierarchy_level] = "grand_total") / 100
		formatString: 0.0%
		lineageTag: 2a534614-b7bc-4e1f-9a6a-1f32bf6b2345

	measure 'MoM Credit Growth' = CALCULATE(MAX(Credit[mom_growth_pct]), Credit[hierarchy_level] = "grand_total") / 100
		formatString: 0.0%
		lineageTag: fd423d0e-6580-4207-9341-585561f54da5

	measure HHI = MAX(Credit[hhi_index])
		formatString: #,0.0
		lineageTag: fa3df108-911c-421b-87c0-3a8253359894

	measure 'Top 3 Sector Share' = MAX(Credit[top3_concentration_share_pct]) / 100
		formatString: 0.0%
		lineageTag: ebf405e5-96bc-446c-b3d5-3826b973b98c

	measure 'Exclusive Sector Credit Cr' = CALCULATE(SUM(Credit[credit_outstanding_cr]), Credit[is_mutually_exclusive] = TRUE())
		formatString: #,0.00
		lineageTag: d34c54d9-f071-4998-a26a-f0cf64d6c7ba

	measure 'Credit Index Base 100' = MAX(Credit[credit_indexed_base100])
		formatString: #,0.0
		lineageTag: c8cbd47c-559b-4b26-a0d4-c8a62e26d215

	measure 'Data Exceptions' = CALCULATE(COUNTROWS(Credit), Credit[quality_status] <> "valid")
		formatString: #,0
		lineageTag: 88c4efdd-f01f-4f43-8c00-ad9d6f430af5

