              },
              {
                "textRuns": [
                  {
                    "value": "The source is RBI DBIE: Table 16 reports industry-wise bank credit; Table 15 is a separate major-sector series and is not added into Table 16 totals. The Jan 2019\u2013Jun 2026 files are bundled historical snapshots served locally for repeatable analysis; this report does not fetch live from RBI.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "15px",
                      "color": "#334155"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "CreditLens uses the published aggregate bank series. It describes lending by sector, not individual borrower risk or loan defaults.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#475569"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
