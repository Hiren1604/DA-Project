# Environment configuration for CreditLens
APP_ENV=development
LOG_LEVEL=INFO

# Database connection
# Default uses local SQLite file
DATABASE_URL=sqlite:///data/processed/credit_lens.db

# For PostgreSQL deployment, use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/creditlens

# API Server configuration
API_HOST=0.0.0.0
API_PORT=8000
